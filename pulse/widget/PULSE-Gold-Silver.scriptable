{"name": "PULSE Gold Silver", "script": "// PULSE Gold Silver · mały widżet ekranu głównego\nconst fm=FileManager.local();\nconst cacheFile=fm.joinPath(fm.cacheDirectory(),'pulse-gold-silver-v1.json');\nasync function metal(symbol){\n  const req=new Request('https://api.gold-api.com/price/'+symbol);\n  req.timeoutInterval=8;\n  const q=await req.loadJSON();\n  const price=Number(q.price),at=Date.parse(q.updatedAt);\n  if(!Number.isFinite(price)||price<=0||!Number.isFinite(at))throw Error('Brak ceny');\n  return {price,at};\n}\nlet data=null,cached=false;\ntry{\n  const [gold,silver]=await Promise.all([metal('XAU'),metal('XAG')]);\n  if(Math.abs(gold.at-silver.at)>600000)throw Error('Różne czasy odczytów');\n  let previous=null;\n  try{previous=JSON.parse(fm.readString(cacheFile))}catch{}\n  const time=Math.min(gold.at,silver.at),ratio=gold.price/silver.price;\n  const points=(Array.isArray(previous?.points)?previous.points:[]).filter(p=>Array.isArray(p)&&Number.isFinite(p[0])&&p[0]>=time-86400000&&p[0]<time&&Number.isFinite(p[1])&&p[1]>0);\n  points.push([time,ratio]);\n  data={ratio,time,gold:gold.price,silver:silver.price,points:points.slice(-120)};\n  try{fm.writeString(cacheFile,JSON.stringify(data))}catch{}\n}catch{\n  try{const q=JSON.parse(fm.readString(cacheFile));if(q.ratio>0&&Number.isFinite(q.ratio)&&Number.isFinite(q.time))data=q}catch{}\n  cached=true;\n}\nconst widget=new ListWidget();\n// iOS associates saved layouts with TradingView when the URL has no symbol query.\nconst settings=fm.joinPath(fm.documentsDirectory(),'pulse-xauxag-layout.txt');\nfunction layoutLink(input){\n  const match=String(input||'').trim().match(/^https:\\/\\/(?:[a-z]{2,3}\\.)?tradingview\\.com\\/chart\\/([A-Za-z0-9]{8})(?:[/?#].*)?$/i);\n  return match?'https://www.tradingview.com/chart/'+match[1]+'/':'';\n}\nconst param=(args.widgetParameter||'').trim();\nlet link=layoutLink(param);\nif(!link && fm.fileExists(settings))link=layoutLink(fm.readString(settings));\nif(!config.runsInWidget && !param){\n  const form=new Alert();\n  form.title='Wykres SAXO:XAUXAG';\n  form.message='Wklej link skopiowany z osobnego układu TradingView zapisanego z instrumentem SAXO:XAUXAG.';\n  form.addTextField('https://www.tradingview.com/chart/…/',link);\n  form.addAction('Zapisz');form.addCancelAction('Anuluj');\n  if(await form.presentAlert()===0){\n    const saved=layoutLink(form.textFieldValue(0));\n    if(saved){link=saved;fm.writeString(settings,saved)}\n    else {const warning=new Alert();warning.title='Potrzebny link do zapisanego układu';warning.message='Adres musi zawierać identyfikator po /chart/. Skopiuj link do układu z aplikacji TradingView.';warning.addAction('OK');await warning.presentAlert()}\n  }\n}\nwidget.url=layoutLink(param)||(param&&!/^https?:/i.test(param)?'shortcuts://run-shortcut?name='+encodeURIComponent(param):link)||URLScheme.forRunningScript();\nwidget.refreshAfterDate=new Date(Date.now()+15*60000);\nwidget.setPadding(12,13,11,13);\nconst gradient=new LinearGradient();\ngradient.startPoint=new Point(0,0);\ngradient.endPoint=new Point(1,1);\ngradient.colors=['#494A47','#212323','#151616','#403521'].map(hex=>new Color(hex));\ngradient.locations=[0,.24,.65,1];\nwidget.backgroundGradient=gradient;\n\nfunction label(container,value,font,color){\n  const text=container.addText(value);\n  text.font=font;text.textColor=new Color(color);\n  text.lineLimit=1;text.minimumScaleFactor=.68;\n  return text;\n}\nconst top=widget.addStack();\ntop.centerAlignContent();\nlabel(top,'XAU',Font.boldSystemFont(13),'#F0CE83');\nlabel(top,' / ',Font.systemFont(12),'#828489');\nlabel(top,'XAG',Font.boldSystemFont(13),'#D7DEE3');\ntop.addSpacer();\nlabel(top,'PULSE',Font.boldSystemFont(9),'#B3B2AA');\nwidget.addSpacer();\nlabel(widget,data?data.ratio.toLocaleString('pl-PL',{minimumFractionDigits:2,maximumFractionDigits:2}):'—',Font.boldSystemFont(42),'#F2E4C4');\nconst points=Array.isArray(data?.points)?data.points.filter(p=>Array.isArray(p)&&p.length===2&&p.every(Number.isFinite)):[];\nif(points.length>=2 && points.at(-1)[0]>points[0][0]){\n  const w=140,h=25,c=new DrawContext();c.size=new Size(w,h);c.respectScreenScale=true;c.opaque=false;\n  const vals=points.map(p=>p[1]),lo=Math.min(...vals),hi=Math.max(...vals);\n  const line=new Path(),fill=new Path(),span=points.at(-1)[0]-points[0][0];\n  for(let i=0;i<points.length;i++){\n    const x=2+(w-4)*(points[i][0]-points[0][0])/span,y=hi===lo?h/2:3+(h-6)*(hi-vals[i])/(hi-lo);\n    if(i===0){line.move(new Point(x,y));fill.move(new Point(x,h));fill.addLine(new Point(x,y))}else{line.addLine(new Point(x,y));fill.addLine(new Point(x,y))}\n    if(i===points.length-1){fill.addLine(new Point(x,h));fill.closeSubpath();c.addPath(fill);c.setFillColor(new Color('#D4B573',.14));c.fillPath();c.setFillColor(new Color('#FFF0B9'));c.fillEllipse(new Rect(x-2,y-2,4,4))}\n  }\n  c.addPath(line);c.setLineWidth(1.7);c.setStrokeColor(new Color('#DFC585'));c.strokePath();\n  const image=widget.addImage(c.getImage());image.imageSize=new Size(w,h);image.leftAlignImage();\n  const pct=(vals.at(-1)/vals[0]-1)*100;\n  const hours=Math.floor(span/3600000),minutes=Math.max(1,Math.round(span/60000));\n  label(widget,(pct>0?'+':'')+pct.toLocaleString('pl-PL',{maximumFractionDigits:2})+'% · '+(hours?hours+' godz.':minutes+' min'),Font.mediumSystemFont(10),'#D7CBB2');\n}else{\n  label(widget,'Uncje srebra za 1 oz złota',Font.mediumSystemFont(10),'#D1CCC0');\n  if(data?.silver>0)label(widget,'Ag   '+data.silver.toLocaleString('pl-PL',{maximumFractionDigits:2})+' USD/oz',Font.mediumSystemFont(10),'#ADB7C1');\n}\nwidget.addSpacer();\nconst dateFormat=new DateFormatter();\ndateFormat.locale='pl_PL';\nconst today=data && new Date(data.time).toDateString()===new Date().toDateString();\ndateFormat.dateFormat=today?'HH:mm':'dd.MM HH:mm';\nconst stamp=data?dateFormat.string(new Date(data.time)):'';\nconst meta=data?(cached?'Zapisane':'Kurs z')+' · '+stamp:'Brak notowań';\nlabel(widget,meta,Font.mediumSystemFont(11),'#C0BDB5');\nif(config.runsInWidget)Script.setWidget(widget);\nelse await widget.presentSmall();\nScript.complete();\n", "icon": {"color": "amber", "glyph": "coins"}, "always_run_in_app": false, "share_sheet_inputs": []}