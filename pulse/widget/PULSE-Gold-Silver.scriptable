{"name": "PULSE Gold Silver", "script": "// PULSE Gold Silver · średni widżet ekranu głównego\nconst site='https://nobodymichael.github.io/pulse/';\nconst fm=FileManager.local();\nconst cacheFile=fm.joinPath(fm.cacheDirectory(),'pulse-gold-silver-v1.json');\nasync function metal(symbol){\n  const req=new Request('https://api.gold-api.com/price/'+symbol);\n  req.timeoutInterval=8;\n  const q=await req.loadJSON();\n  const price=Number(q.price),at=Date.parse(q.updatedAt);\n  if(!Number.isFinite(price)||price<=0||!Number.isFinite(at))throw Error('Brak ceny');\n  return {price,at};\n}\nlet data=null,cached=false;\ntry{\n  const [gold,silver]=await Promise.all([metal('XAU'),metal('XAG')]);\n  if(Math.abs(gold.at-silver.at)>600000)throw Error('Różne czasy odczytów');\n  data={ratio:gold.price/silver.price,time:Math.min(gold.at,silver.at)};\n  try{fm.writeString(cacheFile,JSON.stringify(data))}catch{}\n}catch{\n  try{const q=JSON.parse(fm.readString(cacheFile));if(q.ratio>0&&Number.isFinite(q.ratio)&&Number.isFinite(q.time))data=q}catch{}\n  cached=true;\n}\nfunction surface(w,h){\n  const ctx=new DrawContext();ctx.size=new Size(w,h);ctx.opaque=false;ctx.respectScreenScale=false;return ctx;\n}\nconst medium=new ListWidget();\nmedium.url=site+'#gold-silver';\nmedium.refreshAfterDate=new Date(Date.now()+15*60000);\nmedium.setPadding(0,0,0,0);\nconst ctx=surface(700,332);\nctx.drawImageInRect(Image.fromData(Data.fromBase64String('')),new Rect(0,0,700,332));\nconst digits=Image.fromData(Data.fromBase64String(''));\nconst chars='0123456789,– ';\nconst number=data?data.ratio.toLocaleString('pl-PL',{maximumFractionDigits:2,useGrouping:false}):'–';\nlet x=34;\nfor(let i=0;i<number.length;i++){\n  const index=chars.indexOf(number[i]);if(index<0)continue;\n  const row=Math.round(7*i/Math.max(1,number.length-1));\n  const cell=surface(64,104);\n  cell.drawImageInRect(digits,new Rect(-index*64,-row*104,832,832));\n  ctx.drawImageAtPoint(cell.getImage(),new Point(x,111));\n  x+=number[i]===','?20:45;\n}\nctx.setFont(Font.systemFont(19));ctx.setTextColor(new Color('#b6b4aa'));\nconst dateFormat=new DateFormatter();dateFormat.locale='pl_PL';dateFormat.dateFormat='dd.MM.yyyy, HH:mm';\nconst stale=cached||(data&&Date.now()-data.time>600000);\nconst label=data?(stale?'Zapisane · ':'')+'Gold API · '+dateFormat.string(new Date(data.time)):'Brak zgodnych notowań obu metali';\nctx.drawTextInRect(label,new Rect(34,284,632,33));\nmedium.backgroundImage=ctx.getImage();\nif(config.runsInWidget)Script.setWidget(medium);\nelse await medium.presentMedium();\nScript.complete();\n", "icon": {"color": "amber", "glyph": "coins"}, "always_run_in_app": false, "share_sheet_inputs": []}