{"name": "PULSE Gold Silver", "script": "// PULSE Gold Silver · mały widżet ekranu głównego\nconst fm=FileManager.local();\nconst cacheFile=fm.joinPath(fm.cacheDirectory(),'pulse-gold-silver-v1.json');\nasync function metal(symbol){\n  const req=new Request('https://api.gold-api.com/price/'+symbol);\n  req.timeoutInterval=8;\n  const q=await req.loadJSON();\n  const price=Number(q.price),at=Date.parse(q.updatedAt);\n  if(!Number.isFinite(price)||price<=0||!Number.isFinite(at))throw Error('Brak ceny');\n  return {price,at};\n}\nlet data=null,cached=false;\ntry{\n  const [gold,silver]=await Promise.all([metal('XAU'),metal('XAG')]);\n  if(Math.abs(gold.at-silver.at)>600000)throw Error('Różne czasy odczytów');\n  data={ratio:gold.price/silver.price,time:Math.min(gold.at,silver.at)};\n  try{fm.writeString(cacheFile,JSON.stringify(data))}catch{}\n}catch{\n  try{const q=JSON.parse(fm.readString(cacheFile));if(q.ratio>0&&Number.isFinite(q.ratio)&&Number.isFinite(q.time))data=q}catch{}\n  cached=true;\n}\nconst widget=new ListWidget();\nconst shortcut=(args.widgetParameter || '').trim();\nwidget.url=shortcut ? 'shortcuts://run-shortcut?name='+encodeURIComponent(shortcut) : 'tradingview://chart?symbol=OANDA%3AXAUXAG';\nwidget.refreshAfterDate=new Date(Date.now()+15*60000);\nwidget.setPadding(14,14,13,14);\nconst gradient=new LinearGradient();\ngradient.startPoint=new Point(0,0);\ngradient.endPoint=new Point(1,1);\ngradient.colors=['#33373A','#1B1D20','#151619','#302B22'].map(hex=>new Color(hex));\ngradient.locations=[0,.29,.68,1];\nwidget.backgroundGradient=gradient;\n\nfunction label(container,value,font,color){\n  const text=container.addText(value);\n  text.font=font;text.textColor=new Color(color);\n  text.lineLimit=1;text.minimumScaleFactor=.68;\n  return text;\n}\nconst top=widget.addStack();\ntop.centerAlignContent();\nlabel(top,'XAU',Font.boldSystemFont(13),'#F0CE83');\nlabel(top,' / ',Font.systemFont(12),'#828489');\nlabel(top,'XAG',Font.boldSystemFont(13),'#D7DEE3');\ntop.addSpacer();\nlabel(top,'↗',Font.systemFont(15),'#B3B2AA');\nwidget.addSpacer();\nlabel(widget,data?data.ratio.toLocaleString('pl-PL',{minimumFractionDigits:2,maximumFractionDigits:2}):'—',Font.boldSystemFont(42),'#F2E4C4');\nlabel(widget,'Złoto / srebro',Font.mediumSystemFont(12),'#CACCD0');\nwidget.addSpacer();\nconst dateFormat=new DateFormatter();\ndateFormat.locale='pl_PL';\nconst today=data && new Date(data.time).toDateString()===new Date().toDateString();\ndateFormat.dateFormat=today?'HH:mm':'dd.MM HH:mm';\nconst stamp=data?dateFormat.string(new Date(data.time)):'';\nconst meta=data?(cached?'Zapisane':'Kurs z')+' · '+stamp:'Brak notowań';\nlabel(widget,meta,Font.mediumSystemFont(11),'#C0BDB5');\nif(config.runsInWidget)Script.setWidget(widget);\nelse await widget.presentSmall();\nScript.complete();\n", "icon": {"color": "amber", "glyph": "coins"}, "always_run_in_app": false, "share_sheet_inputs": []}